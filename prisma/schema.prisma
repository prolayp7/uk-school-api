generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   String                  @unique(map: "schools_code_key") @db.VarChar(32)
  name                   String                  @db.VarChar(200)
  timezone               String                  @default("Europe/London") @db.VarChar(64)
  status                 String                  @default("active") @db.VarChar(16)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships            SchoolMembership[]
  roles                  Role[]
  membershipRoles        MembershipRole[]
  rolePermissions        RolePermission[]
  auditEvents            AuditEvent[]
  outboxEvents            OutboxEvent[]
  persons                Person[]
  academicYears          AcademicYear[]
  terms                  Term[]
  yearGroups             YearGroup[]
  forms                  Form[]
  houses                 House[]
  departments            Department[]
  subjects               Subject[]
  pupilProfiles          PupilProfile[]
  staffProfiles          StaffProfile[]
  parentProfiles         ParentCarerProfile[]
  pupilContacts          PupilContact[]
  pupilEnrolments        PupilEnrolment[]
  classGroups            ClassGroup[]
  classMemberships       ClassMembership[]
  timetableSlots         TimetableSlot[]
  curriculumPlans        CurriculumPlan[]
  schemesOfWork          SchemeOfWork[]
  gradeScales             GradeScale[]
  gradeBands              GradeBand[]
  assessments             Assessment[]
  assessmentResults       AssessmentResult[]
  assessmentRevisions     AssessmentResultRevision[]
  pupilTargets            PupilTarget[]
  examSeries              ExamSeries[]
  examSessions            ExamSession[]
  examCandidates          ExamCandidate[]
  examResults             ExamResult[]
  examResultRevisions     ExamResultRevision[]
  applications           Application[]
  applicationHistory     ApplicationStatusHistory[]
  applicationDocuments  ApplicationDocument[]
  offers                 Offer[]
  enrolmentHandoffs      EnrolmentHandoff[]
  charges                Charge[]
  invoices               Invoice[]
  invoiceLines           InvoiceLine[]
  payments               Payment[]
  refunds                Refund[]
  paymentProviderEvents  PaymentProviderEvent[]
  attendanceCodes        AttendanceCode[]
  attendanceSessions     AttendanceSession[]
  attendanceRecords      AttendanceRecord[]
  attendanceNotes        AttendanceNote[]
  attendanceRevisions    AttendanceRecordRevision[]
  attendanceInterventions AttendanceIntervention[]
  sendProfiles           SendProfile[]
  medicalConditions      MedicalCondition[]
  pupilMedicalConditions PupilMedicalCondition[]
  behaviourIncidents     BehaviourIncident[]
  behaviourRewards       BehaviourReward[]
  behaviourSanctions     BehaviourSanction[]
  detentions             Detention[]
  safeguardingCases      SafeguardingCase[]
  safeguardingConcerns   SafeguardingConcern[]
  safeguardingActions    SafeguardingAction[]
  safeguardingMeetings   SafeguardingMeeting[]
  safeguardingGrants     SafeguardingCaseAccess[]
  supportPlans           SupportPlan[]
  sendTargets            SendTarget[]
  sendTargetReviews      SendTargetReview[]
  sendInterventions      SendIntervention[]
  provisionRecords       ProvisionRecord[]
  medications            Medication[]
  medicationAuthorizations MedicationAuthorization[]
  medicationAdministrations MedicationAdministration[]
  healthcarePlans        HealthcarePlan[]
  medicalIncidents       MedicalIncident[]

  @@map("schools")
}

model User {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailNormalized String             @unique(map: "users_email_normalized_key") @map("email_normalized") @db.VarChar(320)
  passwordHash    String             @map("password_hash") @db.VarChar(255)
  status          String             @default("active") @db.VarChar(16)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships     SchoolMembership[]
  persons         Person[]
  auditEvents     AuditEvent[]
  attendanceMarks AttendanceRecord[] @relation("AttendanceRecordMarker")
  attendanceNotes AttendanceNote[]
  attendanceRevisions AttendanceRecordRevision[]
  attendanceInterventions AttendanceIntervention[]
  safeguardingCaseGrants SafeguardingCaseAccess[] @relation("SafeguardingCaseGrantee")
  safeguardingCaseGrantor SafeguardingCaseAccess[] @relation("SafeguardingCaseGrantor")
  safeguardingConcernsReported SafeguardingConcern[]
  medicationAuthorizationsApproved MedicationAuthorization[] @relation("MedicationAuthorizationApprover")
  medicationAdministrationsRecorded MedicationAdministration[] @relation("MedicationAdministrationActor")
  medicalIncidentsReported MedicalIncident[] @relation("MedicalIncidentReporter")
  assessmentsCreated Assessment[] @relation("AssessmentCreator")
  assessmentResultsEntered AssessmentResult[] @relation("AssessmentResultAuthor")
  assessmentRevisionsChanged AssessmentResultRevision[] @relation("AssessmentRevisionActor")
  pupilTargetsCreated PupilTarget[] @relation("PupilTargetCreator")
  examSeriesCreated ExamSeries[] @relation("ExamSeriesCreator")
  examResultsEntered ExamResult[] @relation("ExamResultAuthor")
  examResultRevisionsChanged ExamResultRevision[] @relation("ExamResultRevisionActor")
  applicationsSubmitted Application[] @relation("ApplicationSubmitter")
  applicationActions ApplicationStatusHistory[] @relation("ApplicationHistoryActor")
  offersCreated Offer[] @relation("OfferCreator")
  handoffsVerified EnrolmentHandoff[] @relation("HandoffVerifier")
  chargesCreated Charge[] @relation("ChargeCreator")
  invoicesCreated Invoice[] @relation("InvoiceCreator")
  parentInvoices Invoice[] @relation("InvoiceParent")
  paymentsInitiated Payment[] @relation("PaymentInitiator")
  refundsCreated Refund[] @relation("RefundCreator")

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model SchoolMembership {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String           @map("school_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  status          String           @default("invited") @db.VarChar(16)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membershipRoles MembershipRole[]

  @@unique([schoolId, userId], map: "school_memberships_school_user_key")
  @@unique([schoolId, id], map: "school_memberships_school_id_key")
  @@index([userId, status], map: "school_memberships_user_status_idx")
  @@map("school_memberships")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String           @map("school_id") @db.Uuid
  code            String           @db.VarChar(64)
  name            String           @db.VarChar(120)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membershipRoles MembershipRole[]
  rolePermissions RolePermission[]

  @@unique([schoolId, code], map: "roles_school_code_key")
  @@unique([schoolId, id], map: "roles_school_id_key")
  @@map("roles")
}

model Permission {
  code            String           @id @db.VarChar(120)
  description     String           @db.VarChar(240)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model MembershipRole {
  schoolId     String           @map("school_id") @db.Uuid
  membershipId String           @map("membership_id") @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  grantedAt    DateTime         @default(now()) @map("granted_at") @db.Timestamptz(6)
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership   SchoolMembership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)
  role         Role             @relation(fields: [schoolId, roleId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)

  @@id([schoolId, membershipId, roleId])
  @@index([schoolId, roleId], map: "membership_roles_role_idx")
  @@map("membership_roles")
}

model RolePermission {
  schoolId       String     @map("school_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code") @db.VarChar(120)
  grantedAt      DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)
  school         School     @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role           Role       @relation(fields: [schoolId, roleId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@id([schoolId, roleId, permissionCode])
  @@index([permissionCode], map: "role_permissions_permission_idx")
  @@map("role_permissions")
}

model Person {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String              @map("school_id") @db.Uuid
  userId         String?             @map("user_id") @db.Uuid
  legalFirstName String              @map("legal_first_name") @db.VarChar(100)
  preferredName  String?             @map("preferred_name") @db.VarChar(100)
  lastName       String              @map("last_name") @db.VarChar(100)
  dateOfBirth    DateTime?           @map("date_of_birth") @db.Date
  seedKey        String?             @map("seed_key") @db.VarChar(80)
  addressLine1   String?             @map("address_line_1") @db.VarChar(160)
  addressLine2   String?             @map("address_line_2") @db.VarChar(160)
  town           String?             @db.VarChar(100)
  postcode       String?             @db.VarChar(16)
  phoneNumber    String?             @map("phone_number") @db.VarChar(32)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user           User?               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pupilProfile   PupilProfile?
  staffProfile   StaffProfile?
  parentProfile  ParentCarerProfile?

  @@unique([schoolId, id], map: "persons_school_id_key")
  @@unique([schoolId, userId], map: "persons_school_user_key")
  @@unique([schoolId, seedKey], map: "persons_school_seed_key")
  @@index([userId], map: "persons_user_idx")
  @@index([schoolId, lastName, legalFirstName], map: "persons_school_name_idx")
  @@map("persons")
}

model AuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  requestId   String?  @map("request_id") @db.VarChar(100)
  metadata    Json     @default("{}") @db.JsonB
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([schoolId, occurredAt(sort: Desc)], map: "audit_events_school_time_idx")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "audit_events_actor_time_idx")
  @@index([entityType, entityId, occurredAt(sort: Desc)], map: "audit_events_entity_time_idx")
  @@map("audit_events")
}

model PupilProfile {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String                  @map("school_id") @db.Uuid
  personId           String                  @map("person_id") @db.Uuid
  upn                String?                 @db.VarChar(13)
  admissionNumber    String                  @map("admission_number") @db.VarChar(32)
  gender             String                  @default("not_recorded") @db.VarChar(32)
  admissionDate      DateTime                @map("admission_date") @db.Date
  status             String                  @default("enrolled") @db.VarChar(16)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  school             School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  person             Person                  @relation(fields: [schoolId, personId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)
  contacts           PupilContact[]
  enrolments         PupilEnrolment[]
  classMemberships   ClassMembership[]
  attendanceRecords  AttendanceRecord[]
  attendanceInterventions AttendanceIntervention[]
  sendProfile        SendProfile?
  medicalConditions  PupilMedicalCondition[]
  behaviourIncidents BehaviourIncident[]
  behaviourRewards   BehaviourReward[]
  behaviourSanctions BehaviourSanction[]
  detentions         Detention[]
  safeguardingCases  SafeguardingCase[]
  safeguardingConcerns SafeguardingConcern[]
  supportPlans          SupportPlan[]
  sendInterventions     SendIntervention[]
  provisionRecords     ProvisionRecord[]
  medicationAuthorizations MedicationAuthorization[]
  medicationAdministrations MedicationAdministration[]
  healthcarePlans      HealthcarePlan[]
  medicalIncidents     MedicalIncident[]
  assessmentResults    AssessmentResult[]
  pupilTargets         PupilTarget[]
  examCandidates       ExamCandidate[]
  pupilApplications    Application[] @relation("ApplicationEnrolledPupil")
  admissionHandoff     EnrolmentHandoff?
  charges              Charge[]

  @@unique([schoolId, id], map: "pupil_profiles_school_id_key")
  @@unique([schoolId, personId], map: "pupil_profiles_school_person_key")
  @@unique([schoolId, admissionNumber], map: "pupil_profiles_school_admission_key")
  @@unique([schoolId, upn], map: "pupil_profiles_school_upn_key")
  @@index([schoolId, status, admissionDate], map: "pupil_profiles_school_status_idx")
  @@map("pupil_profiles")
}

model StaffProfile {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String       @map("school_id") @db.Uuid
  personId     String       @map("person_id") @db.Uuid
  departmentId String?      @map("department_id") @db.Uuid
  staffNumber  String       @map("staff_number") @db.VarChar(32)
  staffType    String       @map("staff_type") @db.VarChar(32)
  jobTitle     String       @map("job_title") @db.VarChar(120)
  email        String       @db.VarChar(320)
  startDate    DateTime     @map("start_date") @db.Date
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  person       Person       @relation(fields: [schoolId, personId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)
  department   Department?  @relation(fields: [schoolId, departmentId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)
  tutorForms   Form[]
  classes      ClassGroup[]
  timetableSlots TimetableSlot[]

  @@unique([schoolId, id], map: "staff_profiles_school_id_key")
  @@unique([schoolId, personId], map: "staff_profiles_school_person_key")
  @@unique([schoolId, staffNumber], map: "staff_profiles_school_number_key")
  @@index([schoolId, staffType], map: "staff_profiles_school_type_idx")
  @@map("staff_profiles")
}

model ParentCarerProfile {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String         @map("school_id") @db.Uuid
  personId            String         @map("person_id") @db.Uuid
  externalId          String?        @map("external_id") @db.VarChar(80)
  title               String?        @db.VarChar(32)
  email               String         @db.VarChar(320)
  phone               String         @db.VarChar(32)
  landline            String?        @db.VarChar(32)
  residentialAddress  String?        @map("residential_address") @db.VarChar(500)
  photoStoragePath    String?        @map("photo_storage_path") @db.VarChar(500)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  school              School         @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  person              Person         @relation(fields: [schoolId, personId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)
  pupils    PupilContact[]
  medicationAuthorizations MedicationAuthorization[]

  @@unique([schoolId, id], map: "parent_carer_profiles_school_id_key")
  @@unique([schoolId, personId], map: "parent_carer_profiles_school_person_key")
  @@unique([schoolId, externalId], map: "parent_carer_profiles_school_external_id_key")
  @@map("parent_carer_profiles")
}

model AcademicYear {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String           @map("school_id") @db.Uuid
  code       String           @db.VarChar(16)
  startsOn   DateTime         @map("starts_on") @db.Date
  endsOn     DateTime         @map("ends_on") @db.Date
  isCurrent  Boolean          @default(false) @map("is_current")
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  terms      Term[]
  enrolments PupilEnrolment[]
  classes    ClassGroup[]
  curriculumPlans CurriculumPlan[]
  examSeries ExamSeries[]
  enrolmentHandoffs EnrolmentHandoff[]

  @@unique([schoolId, id], map: "academic_years_school_id_key")
  @@unique([schoolId, code], map: "academic_years_school_code_key")
  @@map("academic_years")
}

model Term {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  code           String       @db.VarChar(24)
  startsOn       DateTime     @map("starts_on") @db.Date
  endsOn         DateTime     @map("ends_on") @db.Date
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear   AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([schoolId, academicYearId, code], map: "terms_school_year_code_key")
  @@map("terms")
}

model YearGroup {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String           @map("school_id") @db.Uuid
  code       String           @db.VarChar(16)
  name       String           @db.VarChar(32)
  keyStage   String           @map("key_stage") @db.VarChar(8)
  sortOrder  Int              @map("sort_order")
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  forms      Form[]
  enrolments PupilEnrolment[]
  classes    ClassGroup[]
  curriculumPlans CurriculumPlan[]
  applications Application[]
  enrolmentHandoffs EnrolmentHandoff[]

  @@unique([schoolId, id], map: "year_groups_school_id_key")
  @@unique([schoolId, code], map: "year_groups_school_code_key")
  @@map("year_groups")
}

model Form {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  yearGroupId  String           @map("year_group_id") @db.Uuid
  tutorStaffId String?          @map("tutor_staff_id") @db.Uuid
  code         String           @db.VarChar(24)
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  yearGroup    YearGroup        @relation(fields: [schoolId, yearGroupId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)
  tutor        StaffProfile?    @relation(fields: [schoolId, tutorStaffId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)
  enrolments   PupilEnrolment[]
  enrolmentHandoffs EnrolmentHandoff[]

  @@unique([schoolId, id], map: "forms_school_id_key")
  @@unique([schoolId, yearGroupId, id], map: "forms_school_year_id_key")
  @@unique([schoolId, code], map: "forms_school_code_key")
  @@index([schoolId, yearGroupId], map: "forms_school_year_group_idx")
  @@map("forms")
}

model House {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String           @map("school_id") @db.Uuid
  code       String           @db.VarChar(24)
  name       String           @db.VarChar(64)
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrolments PupilEnrolment[]

  @@unique([schoolId, id], map: "houses_school_id_key")
  @@unique([schoolId, code], map: "houses_school_code_key")
  @@map("houses")
}

model Department {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String         @map("school_id") @db.Uuid
  code     String         @db.VarChar(24)
  name     String         @db.VarChar(100)
  school   School         @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staff    StaffProfile[]
  subjects Subject[]

  @@unique([schoolId, id], map: "departments_school_id_key")
  @@unique([schoolId, code], map: "departments_school_code_key")
  @@map("departments")
}

model Subject {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String       @map("school_id") @db.Uuid
  departmentId String?      @map("department_id") @db.Uuid
  code         String       @db.VarChar(24)
  name         String       @db.VarChar(100)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department   Department?  @relation(fields: [schoolId, departmentId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)
  classes      ClassGroup[]
  curriculumPlans CurriculumPlan[]
  schemesOfWork SchemeOfWork[]
  examCandidates ExamCandidate[]
  pupilTargets  PupilTarget[]
  examSessions  ExamSession[]

  @@unique([schoolId, id], map: "subjects_school_id_key")
  @@unique([schoolId, code], map: "subjects_school_code_key")
  @@index([schoolId, departmentId], map: "subjects_school_department_idx")
  @@map("subjects")
}

model PupilContact {
  schoolId                  String             @map("school_id") @db.Uuid
  pupilId                   String             @map("pupil_id") @db.Uuid
  guardianPersonId          String             @map("guardian_person_id") @db.Uuid
  relationship              String             @db.VarChar(32)
  isPrimary                 Boolean            @default(false) @map("is_primary")
  canCollect                Boolean            @default(false) @map("can_collect")
  hasParentalResponsibility Boolean            @default(false) @map("has_parental_responsibility")
  canViewPortal             Boolean            @default(false) @map("can_view_portal")
  startsOn                  DateTime           @default(dbgenerated("CURRENT_DATE")) @map("starts_on") @db.Date
  endsOn                    DateTime?          @map("ends_on") @db.Date
  school                    School             @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pupil                     PupilProfile       @relation(fields: [schoolId, pupilId], references: [schoolId, id], onDelete: Restrict, onUpdate: Cascade)
  guardian                  ParentCarerProfile @relation(fields: [schoolId, guardianPersonId], references: [schoolId, personId], onDelete: Restrict, onUpdate: Cascade)

  @@id([schoolId, pupilId, guardianPersonId])
  @@index([schoolId, guardianPersonId], map: "pupil_contacts_guardian_idx")
  @@map("pupil_contacts")
}

model PupilEnrolment {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  pupilId        String       @map("pupil_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  yearGroupId    String       @map("year_group_id") @db.Uuid
